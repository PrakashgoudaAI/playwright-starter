{
  "name": "playwright-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean-room TypeScript Playwright starter with a synthetic demo application.",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "check": "tsc --noEmit",
    "demo": "node --experimental-strip-types examples/demo-app/server.ts",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "report:allure": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.13.0",
    "typescript": "5.9.3"
  }
}
